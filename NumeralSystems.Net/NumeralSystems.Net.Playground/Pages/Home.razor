@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>NumeralSystems.Net Playground</PageTitle>

@if (string.IsNullOrEmpty(_embedSection))
{
<header class="hero">
    <div class="hero-copy">
        <p class="eyebrow">NumeralSystems.Net 5.3</p>
        <h1>Numbers are exact.<br />Representations are choices.</h1>
        <p class="lead">
            Convert alphabets, explore repeating fractions, and inspect unknown bits.
            Everything runs locally in WebAssembly.
        </p>
    </div>
    <div class="hero-mark" aria-hidden="true">
        <span>1</span><span>0</span><span>?</span><span>1</span>
    </div>
</header>
}

<main class="@EmbedClass">
    @if (string.IsNullOrEmpty(_embedSection))
    {
        <section class="share-toolbar" aria-label="Share and export playground results">
            <div>
                <span class="result-label">Portable results</span>
                <strong>Share, copy, or download the current workspace</strong>
            </div>
            <div class="toolbar-actions">
                <a class="secondary-action link-action" href="docs/">Interactive docs</a>
                <button class="secondary-action" @onclick="CopyShareLink">Copy share link</button>
                <button class="secondary-action" @onclick="CopyResults">Copy results</button>
                <button class="secondary-action" @onclick="DownloadJson">Download JSON</button>
            </div>
            @if (!string.IsNullOrEmpty(_actionStatus))
            {
                <span class="action-status" role="status">@_actionStatus</span>
            }
        </section>
    }

    <section class="tool-grid" aria-label="Numeral tools">
        <article id="converter" class="panel converter-panel">
            <div class="panel-heading">
                <div>
                    <p class="kicker">Base converter</p>
                    <h2>Translate an integer</h2>
                </div>
                <span class="badge">BigInteger</span>
            </div>

            <label for="convert-value">Value</label>
            <input id="convert-value" class="primary-input" @bind="_convertInput" @bind:event="oninput" @onkeyup="ConvertOnEnter" />
            <div class="field-row">
                <div>
                    <label for="from-base">From base</label>
                    <input id="from-base" type="number" min="2" max="256" @bind="_fromBase" @bind:event="oninput" />
                </div>
                <div class="swap" aria-hidden="true">→</div>
                <div>
                    <label for="to-base">To base</label>
                    <input id="to-base" type="number" min="2" max="256" @bind="_toBase" @bind:event="oninput" />
                </div>
            </div>
            <button class="action" @onclick="ConvertValue">Convert</button>

            <div class="result-block" aria-live="polite">
                <span class="result-label">Result</span>
                <output>@_convertOutput</output>
                @if (!string.IsNullOrEmpty(_convertError))
                {
                    <p class="error">@_convertError</p>
                }
            </div>
        </article>

        <article id="fractions" class="panel fraction-panel">
            <div class="panel-heading">
                <div>
                    <p class="kicker">Exact rational</p>
                    <h2>Follow the repeating period</h2>
                </div>
                <span class="badge amber">remainder graph</span>
            </div>

            <div class="fraction-inputs">
                <input aria-label="Numerator" @bind="_numeratorText" @bind:event="oninput" />
                <span>/</span>
                <input aria-label="Denominator" @bind="_denominatorText" @bind:event="oninput" />
                <span class="base-prefix">base</span>
                <input aria-label="Expansion base" type="number" min="2" max="64" @bind="_fractionBase" @bind:event="oninput" />
                <button class="small-action" @onclick="UpdateFraction">Explore</button>
            </div>

            @if (_fractionExpansion is not null)
            {
                <div class="fraction-summary">
                    <strong>@_fractionExpansion.ToString(NumeralAlphabet.CreateDefault(_fractionExpansion.Base))</strong>
                    <span>@(_fractionExpansion.IsTerminating ? "terminating" : $"period {_fractionExpansion.RepeatingLength}")</span>
                </div>
                <div class="digit-strip" aria-label="Fractional digits">
                    @for (var index = 0; index < _fractionExpansion.FractionalDigits.Count; index++)
                    {
                        var period = IsPeriodDigit(index);
                        <span class="@(period ? "period-digit" : "prefix-digit")">@_fractionExpansion.FractionalDigits[index]</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_fractionError))
            {
                <p class="error">@_fractionError</p>
            }

            <div class="chart-heading">
                <span>Period length of 1/d in base @(_fractionExpansion?.Base ?? _fractionBase)</span>
                <span>d = 2…@_chartDenominatorLimit</span>
            </div>
            <div class="chart-scroll">
                <svg id="period-chart" class="period-chart" viewBox="0 0 760 230" role="img" aria-label="Period lengths by denominator">
                    <line x1="34" y1="196" x2="744" y2="196" class="axis" />
                    @foreach (var bar in _periodBars)
                    {
                        <g>
                            <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" class="@(bar.Length == 0 ? "terminating-bar" : "period-bar")" rx="2">
                                <title>1/@bar.Denominator: @(bar.Length == 0 ? "terminating" : $"period {bar.Length}")</title>
                            </rect>
                            @if (bar.Denominator % 5 == 0)
                            {
                                @((MarkupString)$"<text x=\"{bar.X + bar.Width / 2}\" y=\"216\" text-anchor=\"middle\">{bar.Denominator}</text>")
                            }
                        </g>
                    }
                </svg>
            </div>
            <div class="panel-actions">
                <button class="secondary-action" @onclick="DownloadPeriodSvg">Export SVG</button>
                <button class="secondary-action" @onclick="DownloadPeriodCsv">Export CSV</button>
            </div>
        </article>

        <article id="unknown-bits" class="panel bits-panel">
            <div class="panel-heading">
                <div>
                    <p class="kicker">Unknown bits</p>
                    <h2>See the candidate space</h2>
                </div>
                <span class="badge mint">bounded</span>
            </div>

            <label for="bit-pattern">Pattern (MSB → LSB)</label>
            <div class="inline-action">
                <input id="bit-pattern" class="primary-input mono" @bind="_patternText" @bind:event="oninput" />
                <button class="small-action" @onclick="UpdatePattern">Inspect</button>
            </div>

            @if (_bitPattern is not null)
            {
                <div class="bit-cells">
                    @foreach (var bit in _bitPattern.ToArray().Reverse())
                    {
                        <span class="@BitClass(bit)">@(bit.HasValue ? (bit.Value ? "1" : "0") : "?")</span>
                    }
                </div>
                <dl class="metrics">
                    <div><dt>Unknown</dt><dd>@_bitPattern.UnknownBitCount</dd></div>
                    <div><dt>Candidates</dt><dd>@_bitPattern.CandidateCount</dd></div>
                    <div><dt>Unsigned</dt><dd>@_bitPattern.MinValue…@_bitPattern.MaxValue</dd></div>
                    <div><dt>Signed</dt><dd>@_bitPattern.SignedMinValue…@_bitPattern.SignedMaxValue</dd></div>
                </dl>
                <div class="candidate-list">
                    @foreach (var candidate in _bitPattern.EnumerateCandidates(16))
                    {
                        <span>@candidate</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_patternError))
            {
                <p class="error">@_patternError</p>
            }
        </article>

        <article id="constraints" class="panel constraints-panel">
            <div class="panel-heading">
                <div>
                    <p class="kicker">Bit constraints</p>
                    <h2>Compose rules without enumerating</h2>
                </div>
                <span class="badge mint">exact solver</span>
            </div>

            <label for="constraints">One constraint per line (operators: &amp;, |, ^, nand)</label>
            <textarea id="constraints"
                      class="primary-input mono constraint-input"
                      rows="4"
                      @bind="_constraintText"
                      @bind:event="oninput"></textarea>

            <div class="constraint-controls">
                <div>
                    <label for="candidate-limit">Candidate preview limit (0-256)</label>
                    <input id="candidate-limit"
                           type="number"
                           min="0"
                           max="256"
                           @bind="_constraintCandidateLimit" />
                </div>
                <div>
                    <label for="constraint-timeout">Timeout in milliseconds (1-5000)</label>
                    <input id="constraint-timeout"
                           type="number"
                           min="1"
                           max="5000"
                           @bind="_constraintTimeoutMilliseconds" />
                </div>
                <button class="small-action" @onclick="SolveConstraints">Solve constraints</button>
            </div>

            @if (_constraintSolution is { IsSatisfiable: true, Pattern: { } solvedPattern })
            {
                <div class="constraint-status success-status">Satisfiable: exact per-bit projection</div>
                <div class="bit-cells">
                    @foreach (var bit in solvedPattern.ToArray().Reverse())
                    {
                        <span class="@BitClass(bit)">@(bit.HasValue ? (bit.Value ? "1" : "0") : "?")</span>
                    }
                </div>
                <dl class="metrics">
                    <div><dt>Pattern</dt><dd>@solvedPattern</dd></div>
                    <div><dt>Candidates</dt><dd>@_constraintSolution.CandidateCount</dd></div>
                    <div><dt>Unsigned</dt><dd>@solvedPattern.MinValue to @solvedPattern.MaxValue</dd></div>
                    <div><dt>Previewed</dt><dd>@_constraintCandidates.Count / @_constraintCandidateLimit</dd></div>
                </dl>
                @if (_constraintCandidates.Count > 0)
                {
                    <div class="candidate-list">
                        @foreach (var candidate in _constraintCandidates)
                        {
                            <span>@candidate</span>
                        }
                    </div>
                }
            }
            else if (_constraintSolution is { IsSatisfiable: false })
            {
                <div class="constraint-status contradiction-status">No solution: at least one bit is contradictory.</div>
            }

            @if (_constraintSolution is not null)
            {
                <div class="explanation-list" aria-label="Bit-by-bit explanation">
                    <h3>Why, from MSB to LSB</h3>
                    @foreach (var explanation in _constraintSolution.Explanations.Reverse())
                    {
                        <div class="@(explanation.IsContradiction ? "explanation-row contradiction-row" : "explanation-row")">
                            <span class="explanation-index">bit @explanation.BitIndex</span>
                            <span class="explanation-value">@ExplanationValue(explanation)</span>
                            <span>@explanation.Message</span>
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_constraintError))
            {
                <p class="error">@_constraintError</p>
            }
        </article>
    </section>
</main>

@if (string.IsNullOrEmpty(_embedSection))
{
    <footer>
        <span>NumeralSystems.Net</span>
        <span>Exact arithmetic · explicit limits · no server round-trips</span>
    </footer>
}

@code {
    private string _convertInput = "FF";
    private int _fromBase = 16;
    private int _toBase = 2;
    private string _convertOutput = "11111111";
    private string? _convertError;

    private string _numeratorText = "1";
    private string _denominatorText = "7";
    private int _fractionBase = 10;
    private readonly int _chartDenominatorLimit = 40;
    private NumeralExpansion? _fractionExpansion;
    private string? _fractionError;
    private List<PeriodBar> _periodBars = new();

    private string _patternText = "1100????";
    private BitPattern? _bitPattern;
    private string? _patternError;

    private string _constraintText =
        "x & 10101010 = 10001000" + Environment.NewLine +
        "x | 00001111 = 10001111";
    private int _constraintCandidateLimit = 16;
    private int _constraintTimeoutMilliseconds = 250;
    private BitConstraintSolution? _constraintSolution;
    private List<BigInteger> _constraintCandidates = new();
    private string? _constraintError;
    private string? _embedSection;
    private string? _actionStatus;

    private string EmbedClass => string.IsNullOrEmpty(_embedSection)
        ? string.Empty
        : $"embed-mode embed-{_embedSection}";

    protected override void OnInitialized()
    {
        ApplyQueryString();
        ConvertValue();
        UpdateFraction();
        UpdatePattern();
        SolveConstraints();
    }

    private void ConvertOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") ConvertValue();
    }

    private void ConvertValue()
    {
        try
        {
            var source = NumeralAlphabet.CreateDefault(_fromBase);
            var destination = NumeralAlphabet.CreateDefault(_toBase);
            _convertOutput = destination.Encode(source.Decode(_convertInput));
            _convertError = null;
        }
        catch (Exception exception)
        {
            _convertOutput = "—";
            _convertError = exception.Message;
        }
    }

    private void UpdateFraction()
    {
        try
        {
            var numerator = BigInteger.Parse(_numeratorText, CultureInfo.InvariantCulture);
            var denominator = BigInteger.Parse(_denominatorText, CultureInfo.InvariantCulture);
            var value = new RationalValue(numerator, denominator);
            var options = new NumeralConversionOptions(
                2048,
                NumeralRoundingMode.ToNearestEven,
                true,
                InfiniteExpansionBehavior.PreservePeriod);
            _fractionExpansion = value.Expand(_fractionBase, options);
            _periodBars = BuildPeriodBars(_fractionBase, _chartDenominatorLimit);
            _fractionError = null;
        }
        catch (Exception exception)
        {
            _fractionExpansion = null;
            _periodBars.Clear();
            _fractionError = exception.Message;
        }
    }

    private bool IsPeriodDigit(int index) =>
        _fractionExpansion?.RepeatingStartIndex is int start &&
        index >= start &&
        index < start + _fractionExpansion.RepeatingLength;

    private static List<PeriodBar> BuildPeriodBars(int baseValue, int maximumDenominator)
    {
        var lengths = new List<(int Denominator, int Length)>();
        var maximumLength = 1;
        var options = new NumeralConversionOptions(
            2048,
            NumeralRoundingMode.ToNearestEven,
            true,
            InfiniteExpansionBehavior.PreservePeriod);

        for (var denominator = 2; denominator <= maximumDenominator; denominator++)
        {
            var expansion = new RationalValue(1, denominator).Expand(baseValue, options);
            var length = expansion.RepeatingLength;
            maximumLength = Math.Max(maximumLength, length);
            lengths.Add((denominator, length));
        }

        const double left = 38;
        const double bottom = 196;
        const double chartHeight = 160;
        var slot = 700d / lengths.Count;
        return lengths.Select((item, index) =>
        {
            var height = item.Length == 0 ? 4 : chartHeight * item.Length / maximumLength;
            return new PeriodBar(
                item.Denominator,
                item.Length,
                left + index * slot,
                bottom - height,
                Math.Max(3, slot - 3),
                height);
        }).ToList();
    }

    private void UpdatePattern()
    {
        try
        {
            _bitPattern = BitPattern.Parse(_patternText);
            _patternError = null;
        }
        catch (Exception exception)
        {
            _bitPattern = null;
            _patternError = exception.Message;
        }
    }

    private static string BitClass(bool? bit) => bit switch
    {
        true => "bit bit-one",
        false => "bit bit-zero",
        null => "bit bit-unknown"
    };

    private void SolveConstraints()
    {
        try
        {
            if (_constraintCandidateLimit is < 0 or > 256)
                throw new ArgumentOutOfRangeException(
                    nameof(_constraintCandidateLimit),
                    "The candidate preview limit must be between 0 and 256.");
            if (_constraintTimeoutMilliseconds is < 1 or > 5_000)
                throw new ArgumentOutOfRangeException(
                    nameof(_constraintTimeoutMilliseconds),
                    "The timeout must be between 1 and 5000 milliseconds.");

            var constraints = BitConstraintSet.Parse(_constraintText);
            var options = new BitConstraintSolverOptions(
                maximumConstraints: 64,
                maximumBitWidth: 1_024,
                maximumEnumeratedCandidates: _constraintCandidateLimit,
                timeout: TimeSpan.FromMilliseconds(_constraintTimeoutMilliseconds));
            _constraintSolution = constraints.Solve(options);
            _constraintCandidates = _constraintSolution
                .EnumerateCandidates(_constraintCandidateLimit)
                .ToList();
            _constraintError = null;
        }
        catch (Exception exception)
        {
            _constraintSolution = null;
            _constraintCandidates.Clear();
            _constraintError = exception.Message;
        }
    }

    private static string ExplanationValue(BitConstraintBitExplanation explanation)
    {
        if (explanation.IsContradiction) return "!";
        return explanation.RequiredValue switch
        {
            true => "1",
            false => "0",
            null => "?"
        };
    }

    private void ApplyQueryString()
    {
        var query = ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("value", out var value)) _convertInput = value;
        if (TryReadInteger(query, "from", 2, 256, out var fromBase)) _fromBase = fromBase;
        if (TryReadInteger(query, "to", 2, 256, out var toBase)) _toBase = toBase;
        if (query.TryGetValue("numerator", out var numerator)) _numeratorText = numerator;
        if (query.TryGetValue("denominator", out var denominator)) _denominatorText = denominator;
        if (TryReadInteger(query, "fractionBase", 2, 64, out var fractionBase)) _fractionBase = fractionBase;
        if (query.TryGetValue("pattern", out var pattern)) _patternText = pattern;
        if (query.TryGetValue("constraints", out var constraints)) _constraintText = constraints;
        if (TryReadInteger(query, "limit", 0, 256, out var limit)) _constraintCandidateLimit = limit;
        if (TryReadInteger(query, "timeout", 1, 5_000, out var timeout))
            _constraintTimeoutMilliseconds = timeout;
        if (query.TryGetValue("embed", out var embed) &&
            embed is "convert" or "fraction" or "bits" or "constraints")
            _embedSection = embed;
    }

    private async Task CopyShareLink()
    {
        var uri = new Uri(Navigation.Uri);
        var link = uri.GetLeftPart(UriPartial.Path) + BuildQueryString();
        Navigation.NavigateTo(link, replace: true);
        await JavaScript.InvokeVoidAsync("numeralSystems.copyText", link);
        _actionStatus = "Share link copied.";
    }

    private async Task CopyResults()
    {
        var lines = new List<string>
        {
            $"Convert: {_convertInput} (base {_fromBase}) = {_convertOutput} (base {_toBase})"
        };
        if (_fractionExpansion is not null)
        {
            lines.Add(
                $"Fraction: {_numeratorText}/{_denominatorText} = " +
                _fractionExpansion.ToString(NumeralAlphabet.CreateDefault(_fractionExpansion.Base)));
        }
        if (_bitPattern is not null)
            lines.Add($"Pattern: {_bitPattern}; candidates: {_bitPattern.CandidateCount}");
        if (_constraintSolution is not null)
            lines.Add(_constraintSolution.IsSatisfiable
                ? $"Constraints: {_constraintSolution.Pattern}; candidates: {_constraintSolution.CandidateCount}"
                : "Constraints: no solution");

        await JavaScript.InvokeVoidAsync(
            "numeralSystems.copyText",
            string.Join(Environment.NewLine, lines));
        _actionStatus = "Results copied.";
    }

    private async Task DownloadJson()
    {
        var json = JsonSerializer.Serialize(BuildSnapshot(), new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            WriteIndented = true
        });
        await JavaScript.InvokeVoidAsync(
            "numeralSystems.downloadText",
            "numeralsystems-results.json",
            json,
            "application/json;charset=utf-8");
        _actionStatus = "JSON download created.";
    }

    private async Task DownloadPeriodCsv()
    {
        var rows = new List<string> { "denominator,periodLength,terminating" };
        rows.AddRange(_periodBars.Select(bar =>
            $"{bar.Denominator},{bar.Length},{(bar.Length == 0 ? "true" : "false")}"));
        await JavaScript.InvokeVoidAsync(
            "numeralSystems.downloadText",
            $"periods-base-{_fractionBase}.csv",
            string.Join("\n", rows) + "\n",
            "text/csv;charset=utf-8");
        _actionStatus = "CSV graph data downloaded.";
    }

    private async Task DownloadPeriodSvg()
    {
        await JavaScript.InvokeVoidAsync(
            "numeralSystems.downloadSvg",
            "period-chart",
            $"periods-base-{_fractionBase}.svg");
        _actionStatus = "SVG graph downloaded.";
    }

    private object BuildSnapshot()
    {
        var fractionText = _fractionExpansion?.ToString(
            NumeralAlphabet.CreateDefault(_fractionExpansion.Base));
        return new
        {
            schemaVersion = "1.0",
            generatedBy = "NumeralSystems.Net Playground 5.3.0",
            converter = new
            {
                input = _convertInput,
                fromBase = _fromBase,
                toBase = _toBase,
                result = _convertOutput,
                error = _convertError
            },
            fraction = new
            {
                numerator = _numeratorText,
                denominator = _denominatorText,
                baseValue = _fractionBase,
                result = fractionText,
                terminating = _fractionExpansion?.IsTerminating,
                repeatingStart = _fractionExpansion?.RepeatingStartIndex,
                repeatingLength = _fractionExpansion?.RepeatingLength,
                error = _fractionError
            },
            periodGraph = _periodBars.Select(bar => new
            {
                denominator = bar.Denominator,
                periodLength = bar.Length,
                terminating = bar.Length == 0
            }),
            unknownBits = new
            {
                pattern = _bitPattern?.ToString(),
                unknownBitCount = _bitPattern?.UnknownBitCount,
                candidateCount = _bitPattern?.CandidateCount.ToString(CultureInfo.InvariantCulture),
                minimum = _bitPattern?.MinValue.ToString(CultureInfo.InvariantCulture),
                maximum = _bitPattern?.MaxValue.ToString(CultureInfo.InvariantCulture),
                error = _patternError
            },
            constraints = new
            {
                source = _constraintText,
                satisfiable = _constraintSolution?.IsSatisfiable,
                pattern = _constraintSolution?.Pattern?.ToString(),
                candidateCount = _constraintSolution?.CandidateCount.ToString(CultureInfo.InvariantCulture),
                preview = _constraintCandidates.Select(value => value.ToString(CultureInfo.InvariantCulture)),
                explanation = _constraintSolution?.Explanations.Reverse().Select(explanation => new
                {
                    bitIndex = explanation.BitIndex,
                    state = ExplanationValue(explanation),
                    explanation.Message
                }),
                error = _constraintError
            }
        };
    }

    private string BuildQueryString()
    {
        var values = new Dictionary<string, string>
        {
            ["value"] = _convertInput,
            ["from"] = _fromBase.ToString(CultureInfo.InvariantCulture),
            ["to"] = _toBase.ToString(CultureInfo.InvariantCulture),
            ["numerator"] = _numeratorText,
            ["denominator"] = _denominatorText,
            ["fractionBase"] = _fractionBase.ToString(CultureInfo.InvariantCulture),
            ["pattern"] = _patternText,
            ["constraints"] = _constraintText,
            ["limit"] = _constraintCandidateLimit.ToString(CultureInfo.InvariantCulture),
            ["timeout"] = _constraintTimeoutMilliseconds.ToString(CultureInfo.InvariantCulture)
        };
        return "?" + string.Join("&", values.Select(pair =>
            $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}"));
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var segment in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = segment.IndexOf('=');
            var key = separator < 0 ? segment : segment[..separator];
            var value = separator < 0 ? string.Empty : segment[(separator + 1)..];
            try
            {
                var decodedKey = Uri.UnescapeDataString(key.Replace('+', ' '));
                if (decodedKey.Length == 0) continue;
                result[decodedKey] = Uri.UnescapeDataString(value.Replace('+', ' '));
            }
            catch (UriFormatException)
            {
                // Ignore malformed parameters and retain safe defaults for the panel.
            }
        }
        return result;
    }

    private static bool TryReadInteger(
        IReadOnlyDictionary<string, string> query,
        string key,
        int minimum,
        int maximum,
        out int value)
    {
        value = 0;
        return query.TryGetValue(key, out var text) &&
               int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out value) &&
               value >= minimum &&
               value <= maximum;
    }

    private sealed record PeriodBar(
        int Denominator,
        int Length,
        double X,
        double Y,
        double Width,
        double Height);
}
