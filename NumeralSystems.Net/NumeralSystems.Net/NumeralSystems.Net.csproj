<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>NumeralSystems.Net</PackageId>
        <Version>4.6.0</Version>
        <PackageVersion>4.6.0</PackageVersion>
        <Title>NumeralSystems.Net</Title>
        <Authors>Polecola</Authors>
        <Description>Work with arbitrary numeral systems, primitive bit representations, incomplete values, and reverse bitwise operations.</Description>
        <Copyright>Copyright © MiLattanzio and contributors</Copyright>
        <RepositoryUrl>https://github.com/MiLattanzio/NumeralSystems</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>PastaSoftware</Company>
        <AssemblyVersion>4.6.0.0</AssemblyVersion>
        <FileVersion>4.6.0.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MiLattanzio/NumeralSystems</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>numeral-systems;base-conversion;bitwise;incomplete-values</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Adds exact positional fraction conversion with configurable precision and end-to-end BigInteger support.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Public API documentation is maintained in docs/api-reference.md. Keep malformed XML warnings enabled. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Type\Enumerable\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polecola.Primitive" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.en.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>


</Project>
