<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>NumeralSystems.Net</PackageId>
        <Version>4.7.0</Version>
        <PackageVersion>4.7.0</PackageVersion>
        <Title>NumeralSystems.Net</Title>
        <Authors>Polecola</Authors>
        <Description>Work with arbitrary numeral systems, ordered alphabets, exact cross-base round trips, rational arithmetic, immutable bit patterns, and constraint solving.</Description>
        <Copyright>Copyright © MiLattanzio and contributors</Copyright>
        <RepositoryUrl>https://github.com/MiLattanzio/NumeralSystems</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>PastaSoftware</Company>
        <AssemblyVersion>4.7.0.0</AssemblyVersion>
        <FileVersion>4.7.0.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MiLattanzio/NumeralSystems</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>numeral-systems;numeral-alphabet;base-conversion;round-trip;parser;parse-result;rational-arithmetic;big-integer;bit-pattern;bitwise;constraint-solving;incomplete-values</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Adds ordered immutable NumeralAlphabet presets, exact BigInteger text round trips, structured ParseResult diagnostics, the shared BitPattern engine, bounded candidate enumeration, shifts, rotations, masks, intersections, reverse XOR/NAND, AND constraint solving, cross-base rational arithmetic, tests, benchmarks, and expanded documentation.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Public API documentation is maintained in docs/api-reference.md. Keep malformed XML warnings enabled. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Type\Enumerable\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polecola.Primitive" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.en.md" Pack="true" PackagePath="README.md" />
      <None Include="..\docs\**\*.md" Pack="true" PackagePath="NumeralSystems.Net\docs\%(RecursiveDir)" />
      <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="" />
      <None Include="..\..\CODE_OF_CONDUCT.md" Pack="true" PackagePath="" />
      <None Include="..\..\CONTRIBUTING.md" Pack="true" PackagePath="" />
      <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
      <None Include="..\..\SECURITY.md" Pack="true" PackagePath="" />
    </ItemGroup>


</Project>
