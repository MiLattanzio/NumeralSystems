<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <LangVersion>9</LangVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>NumeralSystems.Net</PackageId>
        <Version>5.0.0</Version>
        <PackageVersion>5.0.0</PackageVersion>
        <Title>NumeralSystems.Net</Title>
        <Authors>Mi Lattanzio</Authors>
        <Description>Exact rational arithmetic and arbitrary-base numeral expansion with ordered alphabets, repeating periods, explicit rounding, Unicode, streaming codecs, and bit patterns.</Description>
        <Copyright>Copyright © Mi Lattanzio and contributors</Copyright>
        <RepositoryUrl>https://github.com/MiLattanzio/NumeralSystems</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>PastaSoftware</Company>
        <AssemblyVersion>5.0.0.0</AssemblyVersion>
        <FileVersion>5.0.0.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MiLattanzio/NumeralSystems</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>numeral-systems;numeral-alphabet;base-conversion;exact-rational;repeating-fractions;rounding;unicode;rune;base16;base32;base64;streaming;span;json;big-integer;bit-pattern</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Adds immutable normalized RationalValue storage, exact cross-base conversion, repeating-period metadata, explicit rounding and infinite-expansion policies, exact rational JSON state, nullable-annotated 5.0 APIs, and a warning-based 4.x migration layer.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Public API documentation is maintained in docs/api-reference.md. Keep malformed XML warnings enabled. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Type\Enumerable\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polecola.Primitive" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.en.md" Pack="true" PackagePath="README.md" />
      <None Include="..\docs\**\*.md" Pack="true" PackagePath="NumeralSystems.Net\docs\%(RecursiveDir)" />
      <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="" />
      <None Include="..\..\CODE_OF_CONDUCT.md" Pack="true" PackagePath="" />
      <None Include="..\..\CONTRIBUTING.md" Pack="true" PackagePath="" />
      <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
      <None Include="..\..\SECURITY.md" Pack="true" PackagePath="" />
    </ItemGroup>


</Project>
