<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <LangVersion>9</LangVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>NumeralSystems.Net</PackageId>
        <Version>4.8.1</Version>
        <PackageVersion>4.8.1</PackageVersion>
        <Title>NumeralSystems.Net</Title>
        <Authors>Mi Lattanzio</Authors>
        <Description>Work with arbitrary numeral systems, ordered alphabets, Unicode Rune transforms, standard Base16/Base32/Base64 codecs, streaming, exact arithmetic, and bit patterns.</Description>
        <Copyright>Copyright © Mi Lattanzio and contributors</Copyright>
        <RepositoryUrl>https://github.com/MiLattanzio/NumeralSystems</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>PastaSoftware</Company>
        <AssemblyVersion>4.8.1.0</AssemblyVersion>
        <FileVersion>4.8.1.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MiLattanzio/NumeralSystems</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>numeral-systems;numeral-alphabet;base-conversion;unicode;rune;base16;base32;base64;streaming;span;json;round-trip;parser;rational-arithmetic;big-integer;bit-pattern</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Removes every obsolete compatibility API, leaving explicit ordered-alphabet, UTF-16, Rune, and standard byte-codec entry points; updates package authorship and project contact information.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Public API documentation is maintained in docs/api-reference.md. Keep malformed XML warnings enabled. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Type\Enumerable\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polecola.Primitive" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.en.md" Pack="true" PackagePath="README.md" />
      <None Include="..\docs\**\*.md" Pack="true" PackagePath="NumeralSystems.Net\docs\%(RecursiveDir)" />
      <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="" />
      <None Include="..\..\CODE_OF_CONDUCT.md" Pack="true" PackagePath="" />
      <None Include="..\..\CONTRIBUTING.md" Pack="true" PackagePath="" />
      <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
      <None Include="..\..\SECURITY.md" Pack="true" PackagePath="" />
    </ItemGroup>


</Project>
